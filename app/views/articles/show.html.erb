<% content_for :title, "#{@article.title} · AnswerLoop" %>
<div class="row page-actions"><%= link_to "← Articles", workspace_articles_path(current_workspace.slug) %><div><% if policy(@article).update? %><%= link_to "Edit", edit_workspace_article_path(current_workspace.slug, @article), class: "button secondary" %><% end %> <% if @article.published? %><%= link_to "Public page", help_article_path(current_workspace.slug, @article.slug), class: "button secondary" %><% end %></div></div>
<article class="card article-detail"><span class="badge"><%= @article.status.humanize %></span><h1><%= @article.title %></h1><p class="muted"><%= @article.category&.name || "Uncategorized" %> · By <%= @article.author.email_address %></p><% if @article.summary.present? %><p class="article-summary"><%= @article.summary %></p><% end %><div class="trix-content"><%= @article.body %></div></article>
<% if policy(@article).destroy? %><p><%= button_to "Delete article", workspace_article_path(current_workspace.slug, @article), method: :delete, class: "button-link danger", data: { turbo_confirm: "Delete this article permanently?" } %></p><% end %>
