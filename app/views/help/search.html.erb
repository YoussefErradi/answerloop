<% content_for :title, "Search · #{@workspace.name}" %>
<section class="hero"><span class="eyebrow"><%= @workspace.name %> help center</span><h1>Search results</h1><%= form_with url: help_search_path(@workspace.slug), method: :get, class: "search-form" do |form| %><%= form.search_field :q, value: @query, placeholder: "Search articles", aria: { label: "Search help articles" }, required: true %><%= form.submit "Search", class: "button" %><% end %></section>
<p><%= link_to "← Help center", help_path(@workspace.slug) %></p>
<section class="card"><p class="muted"><%= pluralize(@articles.size, "result") %><% if @query.present? %> for “<%= @query %>”<% end %></p><% if @articles.any? %><div class="article-list"><% @articles.each do |article| %><article class="article-list-item"><div><h2><%= link_to article.title, help_article_path(@workspace.slug, article.slug) %></h2><p><%= article.summary.presence || article.search_body.truncate(180) %></p></div></article><% end %></div><% else %><p>Try a different phrase, or <%= link_to "contact support", new_help_ticket_path(@workspace.slug) %>.</p><% end %></section>
