<% content_for :title, "Help center · #{@workspace.name}" %>
<section class="hero help-hero"><span class="eyebrow"><%= @workspace.name %> help center</span><h1>How can we help?</h1><p>Find an answer or send our team a message.</p><%= form_with url: help_search_path(@workspace.slug), method: :get, class: "search-form" do |form| %><%= form.search_field :q, placeholder: "Search articles", aria: { label: "Search help articles" }, required: true %><%= form.submit "Search", class: "button" %><% end %></section>
<div class="row page-actions"><h2>Browse articles</h2><%= link_to "Contact support →", new_help_ticket_path(@workspace.slug), class: "button secondary" %></div>
<div class="grid"><% @categories.each do |category| %><% visible = @category_articles[category.id] || [] %><% if visible.any? %><section class="card"><h2><%= category.name %></h2><ul class="link-list"><% visible.each do |article| %><li><%= link_to article.title, help_article_path(@workspace.slug, article.slug) %></li><% end %></ul></section><% end %><% end %></div>
<% if @articles.any? %><section class="card help-recent"><h2>Recent answers</h2><ul class="link-list"><% @articles.each do |article| %><li><%= link_to article.title, help_article_path(@workspace.slug, article.slug) %><span class="tiny"><%= article.summary %></span></li><% end %></ul></section><% else %><section class="card"><h2>Articles are on the way</h2><p>Our team is preparing the help center. You can still contact support.</p><%= link_to "Send a request", new_help_ticket_path(@workspace.slug) %></section><% end %>
