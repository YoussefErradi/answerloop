<% content_for :title, "Sign in · AnswerLoop" %>
<section class="card narrow" style="margin:auto">
  <span class="eyebrow">Welcome back</span>
  <h2>Sign in to AnswerLoop</h2>
  <p>Access your team's workspaces and manage permissions.</p>
  <%= form_with url: session_path do |form| %>
    <div class="field"><%= form.label :email_address, "Email address" %><%= form.email_field :email_address, required: true, autocomplete: "email", autofocus: true %></div>
    <div class="field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password" %></div>
    <%= form.submit "Sign in", class: "button" %>
  <% end %>
  <p class="tiny">New to AnswerLoop? <%= link_to "Create an account", new_registration_path %></p>
</section>
