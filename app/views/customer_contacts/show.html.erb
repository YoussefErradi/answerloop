<% content_for :title, "#{@contact.name} · Contacts" %>
<p><%= link_to "← Contacts", workspace_customer_contacts_path(current_workspace.slug) %></p>
<section class="hero"><span class="eyebrow">Customer contact</span><h1><%= @contact.name %></h1><p><%= mail_to @contact.email %></p></section>
<div class="grid"><section class="card"><h2>Details</h2><%= form_with model: @contact, url: workspace_customer_contact_path(current_workspace.slug, @contact) do |form| %><% if @contact.errors.any? %><div class="errors"><%= @contact.errors.full_messages.to_sentence %></div><% end %><div class="field"><%= form.label :name %><%= form.text_field :name, required: true %></div><div class="field"><%= form.label :email %><%= form.email_field :email, required: true %></div><%= form.submit "Save contact", class: "button" %><% end %></section><section class="card"><h2>Tickets</h2><% if @tickets.any? %><ul class="link-list"><% @tickets.each do |ticket| %><li><%= link_to "##{ticket.id} #{ticket.subject}", workspace_ticket_path(current_workspace.slug, ticket) %><span class="tiny"><%= ticket.status.humanize %></span></li><% end %></ul><% else %><p>No tickets yet.</p><% end %></section></div>
