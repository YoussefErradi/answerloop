<% content_for :title, "Analytics · #{current_workspace.name}" %>
<section class="hero"><span class="eyebrow">Insights</span><h1>Workspace analytics</h1><p>See what customers search for and how your support team is doing.</p></section>
<div class="row page-actions"><%= link_to "← Workspace", workspace_path(current_workspace.slug) %><nav class="filter-nav" aria-label="Time range"><% [7, 30, 90].each do |days| %><%= link_to "#{days} days", workspace_analytics_path(current_workspace.slug, days: days), class: @days == days ? "active" : nil %><% end %></nav></div>
<div class="metric-grid"><div class="card metric"><span>Published articles</span><strong><%= @published_articles %></strong></div><div class="card metric"><span>Draft articles</span><strong><%= @draft_articles %></strong></div><div class="card metric"><span>New tickets</span><strong><%= @new_tickets %></strong></div><div class="card metric"><span>Resolved tickets</span><strong><%= @resolved_tickets %></strong></div><div class="card metric"><span>Open tickets</span><strong><%= @open_tickets %></strong></div><div class="card metric"><span>Searches</span><strong><%= @searches %></strong></div><div class="card metric"><span>Searches with no results</span><strong><%= @zero_results %></strong></div></div>
<div class="grid analytics-lists"><section class="card"><h2>Top searches</h2><% if @top_queries.any? %><ol class="simple-list"><% @top_queries.each do |query, count| %><li><span><%= query %></span><strong><%= count %></strong></li><% end %></ol><% else %><p>No searches in this period.</p><% end %></section><section class="card"><h2>Tickets by status</h2><ul class="simple-list"><% Ticket.statuses.keys.each do |status| %><li><span><%= status.humanize %></span><strong><%= @ticket_statuses[status] || 0 %></strong></li><% end %></ul></section></div>
