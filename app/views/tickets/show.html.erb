<% content_for :title, "Ticket ##{@ticket.id} · #{current_workspace.name}" %>
<p><%= link_to "← Inbox", workspace_tickets_path(current_workspace.slug) %></p>
<section class="hero"><span class="eyebrow">Support ticket #<%= @ticket.id %></span><h1><%= @ticket.subject %></h1><p><%= @ticket.customer_contact.name %> · <%= mail_to @ticket.customer_contact.email %></p></section>
<div class="ticket-layout">
  <div><section class="card"><h2>Conversation</h2><div class="conversation"><% @messages.each do |message| %><article class="conversation-message <%= 'internal-note' if message.note? %>"><strong><%= message.author&.email_address || @ticket.customer_contact.name %></strong><span class="tiny"><%= message.note? ? "Internal note" : "Reply" %> · <%= l(message.created_at, format: :short) %></span><%= simple_format(message.body) %></article><% end %></div></section>
    <section class="card help-recent"><h2>Add a message</h2><%= form_with model: @message, url: workspace_ticket_ticket_messages_path(current_workspace.slug, @ticket) do |form| %><% if @message.errors.any? %><div class="errors"><%= @message.errors.full_messages.to_sentence %></div><% end %><div class="field"><%= form.label :kind %><%= form.select :kind, [["Reply to customer", "reply"], ["Internal note", "note"]] %></div><div class="field"><%= form.label :body %><%= form.text_area :body, rows: 6, required: true, maxlength: 20000 %></div><%= form.submit "Add message", class: "button" %><% end %></section>
  </div>
  <aside class="card ticket-sidebar"><h2>Details</h2><%= form_with model: @ticket, url: workspace_ticket_path(current_workspace.slug, @ticket) do |form| %><% if @ticket.errors.any? %><div class="errors"><%= @ticket.errors.full_messages.to_sentence %></div><% end %><div class="field"><%= form.label :status %><%= form.select :status, Ticket.statuses.keys.map { |value| [value.humanize, value] } %></div><div class="field"><%= form.label :priority %><%= form.select :priority, Ticket.priorities.keys.map { |value| [value.humanize, value] } %></div><div class="field"><%= form.label :assignee_id, "Assigned to" %><%= form.collection_select :assignee_id, @assignees, :id, :email_address, include_blank: "Unassigned" %></div><%= form.submit "Save details", class: "button" %><% end %></aside>
</div>
