<% content_for :title, "Support inbox · #{current_workspace.name}" %>
<section class="hero"><span class="eyebrow">Support</span><h1>Inbox</h1><p>Track conversations and keep every request moving.</p></section>
<div class="row page-actions"><span><%= link_to "← Workspace", workspace_path(current_workspace.slug) %> · <%= link_to "Contacts", workspace_customer_contacts_path(current_workspace.slug) %> · <%= link_to "Public request form", new_help_ticket_path(current_workspace.slug) %></span><%= link_to "+ New ticket", new_workspace_ticket_path(current_workspace.slug), class: "button" %></div>
<nav class="filter-nav" aria-label="Ticket status"><%= link_to "All", workspace_tickets_path(current_workspace.slug), class: @status.nil? ? "active" : nil %><% Ticket.statuses.keys.each do |status| %><%= link_to status.humanize, workspace_tickets_path(current_workspace.slug, status: status), class: @status == status ? "active" : nil %><% end %></nav>
<section class="card"><% if @tickets.any? %><div class="article-list"><% @tickets.each do |ticket| %><article class="article-list-item"><div><span class="badge"><%= ticket.status.humanize %></span> <span class="tiny"><%= ticket.priority.humanize %> priority</span><h2><%= link_to "##{ticket.id} #{ticket.subject}", workspace_ticket_path(current_workspace.slug, ticket) %></h2><p><%= ticket.customer_contact.name %> · <%= ticket.customer_contact.email %></p><small>Assigned to <%= ticket.assignee&.email_address || "no one" %> · <%= l(ticket.created_at, format: :short) %></small></div><%= link_to "Open →", workspace_ticket_path(current_workspace.slug, ticket) %></article><% end %></div><% else %><p>No tickets in this view.</p><% end %></section>
