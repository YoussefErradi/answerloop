# For running Rails locally without Docker (copy to .env and load in your shell)
DB_HOST=localhost
DB_USERNAME=answerloop
DB_PASSWORD=local_dev_password
# Docker's forwarded PostgreSQL port is 5433. Set DATABASE_URL accordingly when running outside Docker:
DATABASE_URL=postgres://answerloop:local_dev_password@localhost:5433/answerloop_development
MAIL_FROM=no-reply@answerloop.local
CONTACT_EMAIL=hello@answerloop.local
# For demo seed only, never production:
SEED_DEMO=1
DEMO_PASSWORD=ChangeMe12345!
